# Base de datos PostgreSQL (Neon)
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"
# Secreto para firmar las sesiones (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="cambia-este-secreto"
# URL base del sitio (en Vercel se usa VERCEL_URL automáticamente)
APP_URL="https://taskflow.vercel.app"
# SMTP para enviar el código de recuperación de contraseña (Nodemailer)
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="usuario@ejemplo.com"
SMTP_PASS="tu-contraseña"
# Remitente de los correos (por defecto usa SMTP_USER)
# SMTP_FROM="no-reply@ejemplo.com"
