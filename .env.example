# Base de datos PostgreSQL (Neon)
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"
# Secreto para firmar las sesiones (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="cambia-este-secreto"
# URL base del sitio para los enlaces de recuperación (en Vercel se usa VERCEL_URL automáticamente)
APP_URL="https://taskflow.vercel.app"
